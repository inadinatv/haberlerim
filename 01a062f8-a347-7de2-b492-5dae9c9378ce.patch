+    border-color: var(--accent);
+    box-shadow: 0 0 18px var(--glow);
+    cursor: text;
+}
+.arama-saraci input {
+    flex: 1; min-width: 0;
+    background: transparent; border: none; outline: none;
+    color: var(--text-primary); font-size: 0.88rem; font-family: inherit;
