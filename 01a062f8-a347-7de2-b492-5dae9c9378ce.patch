+
+.nav-sag { display: flex; align-items: center; gap: 10px; }
+
+.saat-kutu {
+    display: flex; flex-direction: column; align-items: flex-end;
+    margin-right: 6px; padding-right: 14px;
+    border-right: 1px solid var(--border-color);
