+/* ═════════════════════════════════════════════════════════════
+   GÜNDEM — Premium Haber Design System v2
+   Neon cam (glassmorphism) + vurgu renk teması
+   ═════════════════════════════════════════════════════════════ */
+
+/* ── Temel değişkenler ─────────────────────────────────────── */
+:root {
+    --bg-primary: #050510;
+    --bg-secondary: #0a0a1e;
+    --bg-card: rgba(255, 255, 255, 0.035);
+    --bg-card-hover: rgba(255, 255, 255, 0.07);
+    --bg-glass: rgba(255, 255, 255, 0.05);
+    --bg-glass-strong: rgba(10, 10, 30, 0.88);
+    --border-color: rgba(255, 255, 255, 0.07);
+    --border-hover: rgba(255, 255, 255, 0.18);
+    --text-primary: #f0f0ff;
+    --text-secondary: #9a9ac0;
+    --text-muted: #55557a;
+    --shadow-card: 0 10px 34px rgba(0, 0, 0, 0.45);
+    --nav-yukseklik: 66px;
+    --radius-kart: 22px;
+    --radius-kucuk: 12px;
+    --santim: 1;
+}
+
+/* ── Vurgu renk temaları ───────────────────────────────────── */
+[data-vurgu="cyan"]    { --accent: #00f5ff; --accent-2: #b537f2; --glow: rgba(0, 245, 255, 0.4);  --glow-2: rgba(181, 55, 242, 0.4); }
+[data-vurgu="mor"]     { --accent: #b537f2; --accent-2: #00f5ff; --glow: rgba(181, 55, 242, 0.4); --glow-2: rgba(0, 245, 255, 0.35); }
+[data-vurgu="pembe"]   { --accent: #ff2d7b; --accent-2: #b537f2; --glow: rgba(255, 45, 123, 0.4); --glow-2: rgba(181, 55, 242, 0.35); }
+[data-vurgu="yesil"]   { --accent: #00ff88; --accent-2: #00f5ff; --glow: rgba(0, 255, 136, 0.35);--glow-2: rgba(0, 245, 255, 0.3); }
+[data-vurgu="turuncu"] { --accent: #ff8a3d; --accent-2: #ff2d7b; --glow: rgba(255, 138, 61, 0.4); --glow-2: rgba(255, 45, 123, 0.3); }
+
+:root {
+    --neon-green: #00ff88;
+    --neon-red: #ff4d6d;
+    --neon-pink: #ff2d7b;
+    --neon-yellow: #ffea00;
+}
+
+/* ── Açık tema ─────────────────────────────────────────────── */
+[data-tema="acik"] {
+    --bg-primary: #f4f4fb;
+    --bg-secondary: #ececf6;
+    --bg-card: rgba(255, 255, 255, 0.88);
+    --bg-card-hover: rgba(255, 255, 255, 1);
+    --bg-glass: rgba(255, 255, 255, 0.75);
+    --bg-glass-strong: rgba(250, 250, 255, 0.92);
+    --border-color: rgba(20, 20, 60, 0.08);
+    --border-hover: rgba(20, 20, 60, 0.2);
+    --text-primary: #191938;
+    --text-secondary: #4c4c74;
+    --text-muted: #8a8ab0;
+    --shadow-card: 0 10px 30px rgba(40, 40, 90, 0.1);
+}
+[data-tema="acik"][data-vurgu="cyan"]    { --glow: rgba(0, 150, 180, 0.18); --glow-2: rgba(120, 40, 200, 0.15); }
+[data-tema="acik"][data-vurgu="mor"]     { --glow: rgba(120, 40, 200, 0.18); --glow-2: rgba(0, 150, 180, 0.15); }
+[data-tema="acik"][data-vurgu="pembe"]   { --glow: rgba(220, 30, 100, 0.16); --glow-2: rgba(120, 40, 200, 0.14); }
+[data-tema="acik"][data-vurgu="yesil"]   { --glow: rgba(0, 170, 90, 0.16);  --glow-2: rgba(0, 150, 180, 0.14); }
+[data-tema="acik"][data-vurgu="turuncu"] { --glow: rgba(230, 110, 40, 0.16);--glow-2: rgba(220, 30, 100, 0.14); }
+
+/* ── Sıfırlama ─────────────────────────────────────────────── */
+* { margin: 0; padding: 0; box-sizing: border-box; }
+
+html { scroll-behavior: smooth; }
+
+body {
+    font-family: 'Inter', -apple-system, 'Segoe UI', sans-serif;
+    font-size: 16px;
+    background: var(--bg-primary);
+    color: var(--text-primary);
+    min-height: 100vh;
+    overflow-x: hidden;
+    transition: background 0.5s, color 0.5s;
+    line-height: 1.5;
+}
+[data-yazi="kucuk"] body, html[data-yazi="kucuk"] { font-size: 14.5px; }
+html[data-yazi="buyuk"] { font-size: 18px; }
+
+button { font-family: inherit; }
+::selection { background: var(--glow); color: #fff; }
+
+/* ── Animasyonlu arka plan ─────────────────────────────────── */
+.bg-animated {
+    position: fixed; inset: 0; z-index: 0;
+    background:
+        radial-gradient(ellipse at 18% 40%, var(--glow-2) 0%, transparent 52%),
+        radial-gradient(ellipse at 82% 18%, var(--glow) 0%, transparent 50%),
+        radial-gradient(ellipse at 50% 90%, rgba(255, 45, 123, 0.05) 0%, transparent 55%),
+        linear-gradient(135deg, #050510 0%, #0a0a2e 28%, #0d0a3e 52%, #170a2e 76%, #050510 100%);
+    background-size: 400% 400%;
+    animation: degradeKay 24s ease infinite;
+    opacity: 0.55;
+}
+[data-tema="acik"] .bg-animated {
+    background:
+        radial-gradient(ellipse at 18% 40%, var(--glow-2) 0%, transparent 55%),
+        radial-gradient(ellipse at 82% 18%, var(--glow) 0%, transparent 55%),
+        linear-gradient(135deg, #f4f4fb 0%, #eceefb 30%, #f2ecfb 60%, #ececf6 100%);
+    background-size: 400% 400%;
+    opacity: 0.6;
+}
+.bg-animated::after {
+    content: ''; position: absolute; inset: 0;
+    background-image:
+        linear-gradient(var(--glow) 1px, transparent 1px),
+        linear-gradient(90deg, var(--glow) 1px, transparent 1px);
+    background-size: 64px 64px;
+    opacity: 0.12;
+    animation: icerPulse 5s ease-in-out infinite;
+}
+[data-tema="acik"] .bg-animated::after { opacity: 0.05; }
+
+@keyframes degradeKay { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
+@keyframes icerPulse { 0%, 100% { opacity: 0.08; } 50% { opacity: 0.16; } }
+
+.partikul {
+    position: fixed; border-radius: 50%; pointer-events: none; z-index: 1;
+    background: var(--accent);
+    filter: blur(1px);
+    animation: partikulUc linear infinite;
+}
+@keyframes partikulUc {
+    0% { transform: translateY(102vh) scale(0); opacity: 0; }
+    12% { opacity: 0.8; }
+    88% { opacity: 0.8; }
+    100% { transform: translateY(-80px) scale(1); opacity: 0; }
+}
+
+.scan-line {
+    position: fixed; left: 0; right: 0; height: 2px; z-index: 2;
+    background: linear-gradient(90deg, transparent, var(--accent), transparent);
+    opacity: 0.18; pointer-events: none;
+    animation: tarama 9s linear infinite;
+}
+[data-tema="acik"] .scan-line { opacity: 0.1; }
+@keyframes tarama { 0% { transform: translateY(-100vh); } 100% { transform: translateY(100vh); } }
+
+/* ── Açılış ekranı ─────────────────────────────────────────── */
+.splash-screen {
+    position: fixed; inset: 0; z-index: 10000;
+    background: var(--bg-primary);
+    display: flex; flex-direction: column; align-items: center; justify-content: center;
+    transition: opacity 0.8s ease, visibility 0.8s ease;
+}
+.splash-screen.gizli { opacity: 0; visibility: hidden; pointer-events: none; }
+
+.splash-logo {
+    position: relative;
+    font-family: 'Orbitron', sans-serif;
+    font-size: 3.4rem; font-weight: 900; letter-spacing: 10px;
+    color: transparent;
+    background: linear-gradient(135deg, var(--accent), var(--accent-2), var(--neon-pink));
+    -webkit-background-clip: text; background-clip: text;
+    -webkit-text-fill-color: transparent;
+    animation: splashBoll 2s ease-in-out infinite alternate, splashGel 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
+}
+.splash-logo::after {
+    content: 'GÜNDEM'; position: absolute; inset: 0; z-index: -1;
+    color: transparent;
+    background: linear-gradient(135deg, var(--accent), var(--accent-2));
+    -webkit-background-clip: text; background-clip: text;
+    -webkit-text-fill-color: transparent;
+    filter: blur(24px);
+    animation: blurBoll 2s ease-in-out infinite alternate;
+}
+@keyframes splashBoll { 0% { filter: brightness(1); } 100% { filter: brightness(1.35); } }
+@keyframes splashGel { 0% { transform: scale(0.55); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
+@keyframes blurBoll { 0% { opacity: 0.25; } 100% { opacity: 0.75; } }
+
+.splash-line {
+    width: 0; height: 2px; margin-top: 20px;
+    background: linear-gradient(90deg, transparent, var(--accent), var(--accent-2), transparent);
+    animation: cizgiGenis 1.5s 0.3s ease forwards;
+}
+@keyframes cizgiGenis { to { width: 210px; } }
+
+.splash-subtitle {
+    font-size: 0.82rem; letter-spacing: 6px; text-transform: uppercase;
+    color: var(--text-secondary); margin-top: 16px;
+    opacity: 0; animation: yukselGel 0.6s 0.8s ease forwards;
+}
+@keyframes yukselGel { to { opacity: 1; transform: translateY(0); } }
+
+.splash-loader {
+    margin-top: 32px; width: 62px; height: 3px;
+    background: var(--bg-glass); border-radius: 10px; overflow: hidden;
+    opacity: 0; animation: gecGel 0.3s 1s ease forwards;
+}
+.splash-loader::after {
+    content: ''; display: block; width: 40%; height: 100%;
+    background: linear-gradient(90deg, var(--accent), var(--accent-2));
+    border-radius: 10px;
+    animation: yukleyiciKoc 1.1s ease-in-out infinite;
+}
+@keyframes gecGel { to { opacity: 1; } }
+@keyframes yukleyiciKoc { 0% { transform: translateX(-110%); } 100% { transform: translateX(360%); } }
+
+/* ── İlerleme çubuğu ───────────────────────────────────────── */
+#ilerleme-cubugu {
+    position: fixed; top: 0; left: 0; height: 3px; z-index: 9999; width: 0%;
+    background: linear-gradient(90deg, var(--accent), var(--accent-2));
+    box-shadow: 0 0 12px var(--glow);
+    transition: width 0.1s linear;
+}
+
+/* ── Üst çubuk ─────────────────────────────────────────────── */
+.navbar {
+    position: sticky; top: 0; z-index: 200;
+    height: var(--nav-yukseklik);
+    display: flex; align-items: center; justify-content: space-between;
+    padding: 0 1.6rem;
+    background: var(--bg-glass-strong);
+    backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px);
+    border-bottom: 1px solid var(--border-color);
+    transition: border-color 0.3s;
+}
+.navbar:hover { border-color: var(--border-hover); }
+
+.navbar-brand {
+    display: flex; align-items: center; gap: 11px;
+    text-decoration: none; position: relative;
+}
+.navbar-brand .dot {
+    width: 11px; height: 11px; border-radius: 50%;
+    background: var(--neon-pink);
+    box-shadow: 0 0 10px var(--neon-pink), 0 0 22px rgba(255, 45, 123, 0.5);
+    animation: noktaNabiz 2s ease infinite;
+}
+@keyframes noktaNabiz { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.45); opacity: 0.65; } }
+
+.marka-yazi {
+    font-family: 'Orbitron', sans-serif;
+    font-size: 1.35rem; font-weight: 900; letter-spacing: 3px;
+    background: linear-gradient(135deg, var(--accent), var(--accent-2));
+    -webkit-background-clip: text; background-clip: text;
