+    border: 1px dashed var(--border-color);
+    border-radius: var(--radius-kart);
+}
+.durum-emoji { font-size: 3rem; margin-bottom: 1rem; }
+.durum-baslik { font-size: 1.15rem; font-weight: 800; margin-bottom: 0.5rem; }
+.durum-metin { color: var(--text-muted); font-size: 0.9rem; max-width: 420px; margin: 0 auto 1.4rem; line-height: 1.7; }
+
+/* ── Detay sayfası ─────────────────────────────────────────── */
+.back-btn {
+    display: inline-flex; align-items: center; gap: 10px;
+    padding: 11px 24px; margin-bottom: 1.4rem;
+    background: var(--bg-glass);
+    border: 1px solid var(--border-color);
+    border-radius: 16px;
+    color: var(--accent); font-weight: 700; font-size: 0.85rem;
+    cursor: pointer;
+    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
+    backdrop-filter: blur(10px);
+}
+.back-btn:hover {
+    border-color: var(--accent);
+    transform: translateX(-6px);
+    box-shadow: 0 0 18px var(--glow);
+}
+.back-btn svg { transition: transform 0.3s; }
+.back-btn:hover svg { transform: translateX(-3px); }
+
+.detail-container {
+    max-width: 880px; margin: 0 auto;
+    background: var(--bg-card);
+    border-radius: 30px;
+    border: 1px solid var(--border-color);
+    overflow: hidden;
