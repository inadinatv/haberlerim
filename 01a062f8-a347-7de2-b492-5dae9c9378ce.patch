+}
+.nav-btn:hover {
+    border-color: var(--accent);
+    transform: translateY(-2px) scale(1.06);
+    box-shadow: 0 0 16px var(--glow);
+    color: var(--accent);
+}
+.nav-btn:active { transform: scale(0.95); }
+#btn-yenile.donuyor svg { animation: don 0.9s linear infinite; }
+@keyframes don { to { transform: rotate(360deg); } }
+
+/* ── Kategori çubuğu ───────────────────────────────────────── */
+.category-nav {
+    display: flex; gap: 9px; padding: 13px 1.6rem;
+    background: var(--bg-glass-strong);
+    backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px);
+    border-bottom: 1px solid var(--border-color);
+    overflow-x: auto; white-space: nowrap;
+    position: sticky; top: var(--nav-yukseklik); z-index: 190;
+    -webkit-overflow-scrolling: touch;
+    scroll-behavior: smooth;
+}
+.category-nav::-webkit-scrollbar { height: 0; display: none; }
+
+.cat-btn {
+    position: relative;
+    display: inline-flex; align-items: center; gap: 8px;
+    background: transparent;
+    border: 1.5px solid var(--border-color);
+    color: var(--text-secondary);
+    font-weight: 600; font-size: 0.85rem;
+    padding: 8px 18px; border-radius: 13px;
+    cursor: pointer;
+    transition: all 0.3s ease;
+    letter-spacing: 0.2px;
+}
+.cat-btn .cat-icon { font-size: 0.95rem; }
+.cat-btn .cat-sayac {
+    font-size: 0.62rem; font-weight: 800;
+    background: var(--bg-glass);
+    border: 1px solid var(--border-color);
+    padding: 1.5px 7px; border-radius: 8px;
+    color: var(--text-muted);
+    font-variant-numeric: tabular-nums;
+    transition: all 0.3s;
+}
+.cat-btn:hover {
+    color: var(--text-primary);
+    border-color: var(--accent);
+    background: var(--glow);
+    transform: translateY(-1px);
+}
+.cat-btn.active {
+    background: linear-gradient(135deg, var(--accent), var(--accent-2));
+    color: #fff; border-color: transparent;
+    box-shadow: 0 0 20px var(--glow), 0 4px 18px rgba(0, 0, 0, 0.25);
+    font-weight: 700;
+}
+.cat-btn.active .cat-sayac {
+    background: rgba(255, 255, 255, 0.22);
+    border-color: rgba(255, 255, 255, 0.35);
+    color: #fff;
+}
+.cat-btn .ripple {
+    position: absolute; border-radius: 50%;
+    background: rgba(255, 255, 255, 0.35);
+    transform: scale(0); animation: dalga 0.6s linear;
+    pointer-events: none;
+}
+@keyframes dalga { to { transform: scale(4); opacity: 0; } }
+
+/* ── Piyasa bandı ──────────────────────────────────────────── */
+.market-strip {
+    position: relative; z-index: 10;
+    background: var(--bg-glass);
+    border-bottom: 1px solid var(--border-color);
+    backdrop-filter: blur(14px);
+    overflow: hidden;
+}
+.market-strip.gizli { display: none; }
+
+.market-strip-inner {
+    display: flex; align-items: stretch;
+    width: max-content;
+    animation: piyasaKoc 75s linear infinite;
+}
+.market-strip-inner:hover { animation-play-state: paused; }
+@keyframes piyasaKoc { to { transform: translateX(-50%); } }
+
+.market-item {
+    display: flex; align-items: center; gap: 11px;
+    padding: 10px 26px; white-space: nowrap;
+    border-right: 1px solid var(--border-color);
+    transition: background 0.3s;
+}
+.market-item:hover { background: var(--bg-card); }
+.market-icon {
+    width: 32px; height: 32px; border-radius: 11px;
+    display: flex; align-items: center; justify-content: center;
+    font-size: 0.78rem; font-weight: 800; flex-shrink: 0;
+    transition: transform 0.3s;
+}
+.market-item:hover .market-icon { transform: scale(1.12); }
+.market-bilgi { display: flex; flex-direction: column; line-height: 1.3; }
+.market-adi {
+    font-size: 0.6rem; font-weight: 700;
+    color: var(--text-muted); text-transform: uppercase; letter-spacing: 1.4px;
+}
+.market-deger {
+    font-size: 0.88rem; font-weight: 800;
+    color: var(--text-primary); font-variant-numeric: tabular-nums;
+    display: flex; align-items: center; gap: 8px;
+}
+.market-degisim {
+    font-size: 0.68rem; font-weight: 700;
+    padding: 1px 7px; border-radius: 7px;
+    font-variant-numeric: tabular-nums;
+}
+.market-degisim.yukari { color: var(--neon-green); background: rgba(0, 255, 136, 0.1); }
+.market-degisim.asagi { color: var(--neon-red); background: rgba(255, 77, 109, 0.12); }
+.market-degisim.duz { color: var(--text-muted); background: var(--bg-glass); }
+
+.market-icon.usd    { background: rgba(0, 255, 136, 0.12);  color: var(--neon-green); }
+.market-icon.eur    { background: rgba(67, 97, 238, 0.16);  color: #7b93ff; }
+.market-icon.altin  { background: rgba(255, 234, 0, 0.12);  color: var(--neon-yellow); }
+.market-icon.petrol { background: rgba(255, 107, 53, 0.14); color: #ff8a5c; }
+.market-icon.bist   { background: rgba(0, 245, 255, 0.12);  color: var(--accent); }
+.market-icon.btc    { background: rgba(247, 147, 26, 0.14); color: #f7931a; }
+.market-icon.eth    { background: rgba(140, 150, 255, 0.14);color: #a3aefc; }
+.market-icon.hava   { background: rgba(125, 211, 252, 0.14); color: #7dd3fc; }
+
+/* ── Son dakika bandı ──────────────────────────────────────── */
+.ticker-wrap {
+    background: linear-gradient(90deg, rgba(255, 45, 123, 0.07), transparent 60%);
+    border-bottom: 1px solid var(--border-color);
+    overflow: hidden; height: 42px;
+    display: flex; align-items: center;
+    position: relative; z-index: 10;
+}
+.ticker-wrap.gizli { display: none; }
+
+.ticker-label {
+    background: linear-gradient(135deg, var(--neon-pink), var(--accent-2));
+    color: #fff; font-family: 'Orbitron', sans-serif;
+    font-weight: 700; font-size: 0.62rem; letter-spacing: 2px;
+    padding: 5px 15px; border-radius: 8px; margin-left: 14px;
+    white-space: nowrap; text-transform: uppercase;
+    z-index: 2; flex-shrink: 0;
+    box-shadow: 0 0 14px rgba(255, 45, 123, 0.45);
+    animation: etiketNabiz 2s ease infinite;
+}
+@keyframes etiketNabiz {
+    0%, 100% { box-shadow: 0 0 8px rgba(255, 45, 123, 0.4); }
+    50% { box-shadow: 0 0 22px rgba(255, 45, 123, 0.65); }
+}
+
+.ticker-track {
+    display: flex; animation: bantKoc 220s linear infinite;
+    white-space: nowrap; margin-left: 18px;
+}
+.ticker-track:hover { animation-play-state: paused; }
+.ticker-item {
+    color: var(--text-secondary); font-size: 0.8rem; font-weight: 500;
+    padding: 0 2.4rem; position: relative; cursor: pointer;
+    transition: color 0.3s;
+}
+.ticker-item:hover { color: var(--accent); }
+.ticker-item::before {
+    content: '◆'; position: absolute; left: 0; top: 50%;
+    transform: translateY(-50%);
+    color: var(--accent); font-size: 0.42rem;
+}
+@keyframes bantKoc { to { transform: translateX(-50%); } }
+
+/* ── Ana konteyner + araç çubuğu ───────────────────────────── */
+.main-container {
+    position: relative; z-index: 1;
+    max-width: 1340px; margin: 0 auto;
+    padding: 1.8rem 1.5rem 4rem;
+}
+
+.toolbar {
+    display: flex; align-items: center; justify-content: space-between;
+    gap: 1rem; flex-wrap: wrap;
+    margin-bottom: 1.4rem;
+    padding: 10px 16px;
+    background: var(--bg-card);
+    border: 1px solid var(--border-color);
+    border-radius: 16px;
+    backdrop-filter: blur(10px);
+}
+.toolbar-sol { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
+.sonuc-sayac { font-size: 0.86rem; font-weight: 700; color: var(--text-primary); }
+.son-guncelleme { font-size: 0.74rem; color: var(--text-muted); display: flex; align-items: center; gap: 6px; }
+.son-guncelleme .nabiz-nokta {
+    width: 7px; height: 7px; border-radius: 50%;
+    background: var(--neon-green);
+    box-shadow: 0 0 8px var(--neon-green);
+    animation: noktaNabiz 2s ease infinite;
+}
+.toolbar-sag { display: flex; align-items: center; gap: 10px; }
+
+.sirala-sec {
+    background: var(--bg-glass);
+    color: var(--text-primary);
+    border: 1px solid var(--border-color);
+    border-radius: 11px;
+    padding: 7px 12px;
+    font-size: 0.78rem; font-weight: 600; font-family: inherit;
+    cursor: pointer; outline: none;
+    transition: border-color 0.3s;
+}
+.sirala-sec:hover, .sirala-sec:focus { border-color: var(--accent); }
+.sirala-sec option { background: var(--bg-secondary); color: var(--text-primary); }
+
+.gorunum-dogrultu {
+    display: flex; gap: 4px;
+    background: var(--bg-glass);
+    border: 1px solid var(--border-color);
+    border-radius: 11px; padding: 4px;
+}
+.gorunum-btn {
+    background: transparent; border: none;
+    color: var(--text-muted); cursor: pointer;
+    width: 32px; height: 30px; border-radius: 8px;
+    display: flex; align-items: center; justify-content: center;
+    transition: all 0.25s;
+}
+.gorunum-btn.active {
+    background: linear-gradient(135deg, var(--accent), var(--accent-2));
+    color: #fff;
+    box-shadow: 0 0 12px var(--glow);
+}
+.gorunum-btn:not(.active):hover { color: var(--accent); }
+
+/* ── Haber ızgarası ────────────────────────────────────────── */
+.news-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
+    gap: 1.7rem;
+}
+.news-grid.liste-modu {
+    grid-template-columns: 1fr;
+    gap: 0.9rem;
+}
+@media (max-width: 420px) { .news-grid { grid-template-columns: 1fr; } }
+
+/* ── Haber kartları ────────────────────────────────────────── */
+.news-card {
+    position: relative;
+    background: var(--bg-card);
+    border: 1px solid var(--border-color);
+    border-radius: var(--radius-kart);
+    overflow: hidden;
+    cursor: pointer;
+    transition: transform 0.45s cubic-bezier(0.34, 1.4, 0.64, 1),
+                box-shadow 0.45s, border-color 0.45s, background 0.45s;
+    display: flex; flex-direction: column;
+    backdrop-filter: blur(12px);
+}
+.news-card:hover {
+    transform: translateY(-8px);
+    border-color: transparent;
+    background: var(--bg-card-hover);
+    box-shadow:
+        0 0 0 1.5px var(--accent),
+        0 0 30px var(--glow),
+        0 22px 55px rgba(0, 0, 0, 0.35);
+    z-index: 5;
+}
+.news-card.ozel {
+    grid-column: span 2;
+}
+.news-card.ozel .kart-resim-kenar { height: 300px; }
+.news-card.ozel .kart-baslik { font-size: 1.35rem; -webkit-line-clamp: 3; }
+@media (max-width: 760px) {
+    .news-card.ozel { grid-column: span 1; }
+    .news-card.ozel .kart-resim-kenar { height: 230px; }
+    .news-card.ozel .kart-baslik { font-size: 1.12rem; }
+}
+
+.kart-resim-kenar {
+    position: relative; height: 210px; overflow: hidden;
+    background: var(--bg-secondary);
+}
+.kart-resim-kenar img, .kart-resim-kenar .kart-tutucu {
+    width: 100%; height: 100%; object-fit: cover;
+    transition: transform 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94);
+    display: block;
+}
+.news-card:hover .kart-resim-kenar img,
+.news-card:hover .kart-resim-kenar .kart-tutucu { transform: scale(1.09); }
+.kart-tutucu {
+    display: flex; align-items: center; justify-content: center;
+    font-size: 3.4rem;
+    position: relative;
+}
+.kart-tutucu::after {
+    content: attr(data-kaynak);
+    position: absolute; bottom: 10px; right: 14px;
+    font-family: 'Orbitron', sans-serif;
+    font-size: 0.62rem; font-weight: 700; letter-spacing: 2px;
+    color: rgba(255, 255, 255, 0.5);
+}
+.kart-ust-banti {
+    position: absolute; inset: 0;
+    background: linear-gradient(to top, rgba(5, 5, 16, 0.75) 0%, transparent 55%);
+    pointer-events: none;
+}
+[data-tema="acik"] .kart-ust-banti {
+    background: linear-gradient(to top, rgba(10, 10, 40, 0.45) 0%, transparent 50%);
+}
+
+.kart-rozetler { position: absolute; top: 12px; left: 12px; right: 12px; display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; pointer-events: none; }
+.kaynak-rozet {
+    display: inline-flex; align-items: center; gap: 6px;
+    background: rgba(0, 0, 0, 0.62); backdrop-filter: blur(10px);
+    border: 1px solid rgba(255, 255, 255, 0.14);
+    color: #fff; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.6px;
+    padding: 4.5px 11px; border-radius: 10px;
+    text-transform: uppercase;
+}
+.kaynak-rozet .kaynak-nokta { width: 6px; height: 6px; border-radius: 50%; background: var(--kaynak-renk, var(--accent)); box-shadow: 0 0 8px var(--kaynak-renk, var(--accent)); }
+.son-dakika-rozet {
+    display: inline-flex; align-items: center; gap: 5px;
+    background: linear-gradient(135deg, var(--neon-pink), #ff0844);
+    color: #fff; font-size: 0.6rem; font-weight: 800; letter-spacing: 1px;
+    padding: 4.5px 11px; border-radius: 10px;
+    box-shadow: 0 0 14px rgba(255, 45, 123, 0.55);
+    animation: etiketNabiz 1.8s ease infinite;
+}
+
+.kart-govde { padding: 1.25rem 1.35rem 1.3rem; flex: 1; display: flex; flex-direction: column; }
+.kart-meta {
+    display: flex; align-items: center; gap: 10px;
+    font-size: 0.7rem; font-weight: 700;
+    margin-bottom: 9px;
+}
+.kart-kategori {
+    color: var(--accent);
+    text-transform: uppercase; letter-spacing: 1.2px;
+    display: flex; align-items: center; gap: 5px;
+}
+.kart-zaman { color: var(--text-muted); font-weight: 600; }
+.kart-zaman::before { content: '•'; margin-right: 10px; color: var(--text-muted); }
+.kart-tam {
+    font-size: 0.66rem; font-weight: 700;
+    color: var(--accent);
+    background: var(--glow);
+    border-radius: 8px; padding: 2px 8px;
+    letter-spacing: 0.3px;
+}
+
+.kart-baslik {
+    font-size: 1.06rem; font-weight: 800; line-height: 1.42;
+    margin-bottom: 0.65rem; color: var(--text-primary);
+    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
+    transition: color 0.3s;
+}
+.news-card:hover .kart-baslik { color: var(--accent); }
+
+.kart-aciklama {
+    font-size: 0.83rem; color: var(--text-secondary); line-height: 1.65;
+    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
+    flex: 1;
+}
+.kart-dip {
+    display: flex; align-items: center; justify-content: space-between;
+    margin-top: 12px;
+}
+.kart-oku {
+    display: flex; align-items: center; gap: 6px;
+    font-size: 0.72rem; font-weight: 700; color: var(--accent);
+    opacity: 0; transform: translateX(-8px);
+    transition: all 0.35s ease;
+}
+.news-card:hover .kart-oku { opacity: 1; transform: translateX(0); }
+.kart-oku svg { transition: transform 0.3s; }
+.news-card:hover .kart-oku svg { transform: translateX(3px); }
+.kart-link-bas {
+    font-size: 0.68rem; color: var(--text-muted); font-weight: 600;
+    max-width: 45%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
+}
+
+/* Liste görünümü kartı */
+.news-grid.liste-modu .news-card {
+    flex-direction: row; align-items: stretch;
+    border-radius: 16px;
+}
+.news-grid.liste-modu .news-card:hover { transform: translateX(6px); }
+.news-grid.liste-modu .kart-resim-kenar {
+    width: 190px; height: auto; min-height: 130px; flex-shrink: 0;
+}
+.news-grid.liste-modu .kart-resim-kenar::after { display: none; }
+.news-grid.liste-modu .kart-rozetler { top: 8px; left: 8px; right: auto; }
+.news-grid.liste-modu .kart-rozetler .son-dakika-rozet { display: none; }
+.news-grid.liste-modu .kart-baslik { -webkit-line-clamp: 2; font-size: 0.98rem; }
+.news-grid.liste-modu .kart-aciklama { -webkit-line-clamp: 1; }
+.news-grid.liste-modu .kart-dip { margin-top: 8px; }
+.news-grid.liste-modu .kart-oku { opacity: 1; transform: none; }
+.news-grid.liste-modu .news-card.ozel { grid-column: span 1; }
+@media (max-width: 640px) {
+    .news-grid.liste-modu .kart-resim-kenar { width: 120px; }
+}
+
+/* ── İskelet (yükleniyor) ──────────────────────────────────── */
+.iskelet {
+    border-radius: var(--radius-kart); overflow: hidden;
+    border: 1px solid var(--border-color);
+    background: var(--bg-card);
+}
+.iskelet-kenar { height: 210px; }
+.iskelet-govde { padding: 1.3rem; }
+.iskelet-cizgi {
+    height: 13px; border-radius: 7px; margin-bottom: 12px;
+    background: linear-gradient(90deg, var(--bg-glass) 25%, var(--border-hover) 50%, var(--bg-glass) 75%);
+    background-size: 400% 100%;
+    animation: parlakKoc 1.6s ease infinite;
+}
+.iskelet-cizgi.kisa { width: 45%; }
+.iskelet-cizgi.orta { width: 75%; }
+@keyframes parlakKoc { to { background-position: -400% 0; } }
+
+/* ── Boşluk / hata durumları ───────────────────────────────── */
+.durum-panel {
+    grid-column: 1 / -1;
+    text-align: center;
+    padding: 4.5rem 2rem;
