+/* ── Veri yükleme ──────────────────────────────────────────── */
+async function veriGetir(dizin, cacheBuster) {
+    const url = dizin + (cacheBuster ? '?ts=' + Date.now() : '');
+    const cev = await fetch(url, { cache: 'no-store' });
+    if (!cev.ok) throw new Error(dizin + ' → ' + cev.status);
+    return cev.json();
+}
