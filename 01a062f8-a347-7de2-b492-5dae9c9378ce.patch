+        maddeler.push({ sinif: 'usd', ikon: '$', ad: 'USD/TRY', deger: sayiyaDonus(doviz.Dolar) ? sayiyaDonus(doviz.Dolar).toFixed(4) : '—', degisim: degisimEtiketi(0, doviz.DolarDegisim) });
