+    try {
+        const [h, r] = await Promise.all([
+            veriGetir('haberler.json', true),
+            veriGetir('bot-raporu.json', true).catch(() => null),
+        ]);
+        haberler = Array.isArray(h) ? h : [];
+        rapor = r;
+        renderHepsi();
